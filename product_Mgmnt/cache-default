server {
    server_name tdowebapp.dtlamarketing.com;

    client_max_body_size 500M;

    root /root/Product_Management/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    location /uploads/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    } 

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/tdowebapp.dtlamarketing.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/tdowebapp.dtlamarketing.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = tdowebapp.dtlamarketing.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name tdowebapp.dtlamarketing.com;
    return 404; # managed by Certbot


}
